# Configure at least one provider. Keys stay on the server.
# Groq/OpenRouter require BOTH a key and an explicit model supporting tool calls.
GENAI_PROVIDER_ORDER=gemini,groq,openrouter
GENAI_GROQ_API_KEY=
GENAI_GROQ_MODEL=
GENAI_OPENROUTER_API_KEY=
GENAI_OPENROUTER_MODEL=
GENAI_PROVIDER_TIMEOUT_SECONDS=12
GENAI_GEMINI_ANALYTICAL_TIMEOUT_SECONDS=20
# Analytical calls to OpenRouter share the overall question budget below.
GENAI_OPENROUTER_ANALYTICAL_TIMEOUT_SECONDS=36
GENAI_PROVIDER_BUDGET_SECONDS=40
GENAI_PROVIDER_COOLDOWN_SECONDS=60

# Gemini is optional when another provider is configured.
GENAI_GEMINI_API_KEY=

# Optional; defaults to gemini-3.5-flash-lite.
GENAI_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional; used as the main model for hybrid and more complex questions.
# The same Gemini key works for both models.
GENAI_GEMINI_COMPLEX_MODEL=gemini-3.5-flash

# Optional; used once only when the primary provider call fails temporarily.
# For complex questions, if this is the primary model, the lightweight model is
# used as the alternative instead of repeating the same provider call.
GENAI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Cache local de respostas por conversa; em segundos. Atualizações do Gold ou das
# regras também invalidam uma entrada antes da expiração.
GENAI_RESPONSE_CACHE_TTL_SECONDS=300
GENAI_RESPONSE_CACHE_RULES_VERSION=1
