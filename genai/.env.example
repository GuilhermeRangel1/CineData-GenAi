# Required only for natural-language questions sent to the GenAI provider.
GENAI_GEMINI_API_KEY=

# Optional; defaults to gemini-3.5-flash-lite.
GENAI_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional; used once only when the primary provider call fails temporarily.
GENAI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Cache local de respostas por conversa; em segundos. Atualizações do Gold ou das
# regras também invalidam uma entrada antes da expiração.
GENAI_RESPONSE_CACHE_TTL_SECONDS=300
GENAI_RESPONSE_CACHE_RULES_VERSION=1
